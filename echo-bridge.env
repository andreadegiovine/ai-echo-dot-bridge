# /etc/echo-bridge/echo-bridge.env — configurazione di echo-bridge (riavvia: systemctl restart echo-bridge)

# IP (riserva DHCP!) degli Echo sbloccati, separati da virgola. Modalità ESPHome di default (porta 26053).
# Un Echo in modalità Wyoming: wyoming://192.168.1.51 (porta 16700). Esempio misto:
# ECHO_HOSTS=192.168.1.50,192.168.1.52,wyoming://192.168.1.51
ECHO_HOSTS=192.168.1.50
PROTO=esphome

# Agente: qualsiasi endpoint OpenAI-compatibile /v1/chat/completions.
# - llama.cpp diretto:  http://<ip-lxc-llama>:8080/v1/chat/completions   (niente strumenti)
# - il tuo agente con strumenti, se espone la stessa API: mettilo qui al posto di llama.cpp.
# Il bridge manda solo la domanda (messaggio "user") e nel campo "user" il nome dell'Echo che ha chiesto.
LLM_URL=http://192.168.1.20:8080/v1/chat/completions
LLM_MODEL=local
LLM_API_KEY=
LLM_STREAM=1
LLM_TIMEOUT=120
# Campi extra nel body, JSON. Esempio per Qwen3 su llama.cpp (niente ragionamento lungo prima di rispondere):
# LLM_EXTRA_JSON='{"temperature":0.6,"chat_template_kwargs":{"enable_thinking":false}}'
LLM_EXTRA_JSON={}

# Servizi vocali locali (nello stesso container).
STT_URI=tcp://127.0.0.1:10300
STT_LANG=it
TTS_URI=tcp://127.0.0.1:10200
TTS_VOICE=it_IT-paola-medium

# Fine frase: pausa che chiude la richiesta (ms), aggressività VAD 0..3.
SILENCE_MS=800
VAD_MODE=2
NO_SPEECH_S=6
MAX_REQUEST_S=15

# hassmic abbandona una richiesta dopo 30 s in "pensando": oltre KEEPALIVE_S il bridge manda silenzio all'Echo.
KEEPALIVE_S=20
ERROR_PHRASE="Scusa, non riesco a raggiungere l'agente."

# Sussurro: se parli sottovoce la risposta esce più bassa. In modalità ESPHome decide il sensore dell'Echo
# ("Last request whispered", modello Amazon) se è installato; altrimenti, e in Wyoming, la stima del bridge
# sull'assenza di tono nella voce. Se una voce normale viene presa per sussurro abbassa WHISPER_RATIO; se un
# sussurro non viene riconosciuto alzalo (0.3). Il log mostra la quota misurata: "parlato con tono 6%".
WHISPER_DETECT=1
WHISPER_RATIO=0.2
WHISPER_GAIN_DB=-12

# ---------------------------------------------------------------- solo modalità ESPHome

# Server HTTP del bridge: l'Echo ci scarica le risposte (/audio), l'agente ci trova gli strumenti MCP (/mcp).
HTTP_HOST=0.0.0.0
HTTP_PORT=8124
# Indirizzo del container come lo vede l'Echo. Vuoto: lo ricava da solo (l'IP con cui raggiunge l'Echo).
PUBLIC_HOST=
# Se impostato, /mcp e /api vogliono "Authorization: Bearer <token>" (l'audio per l'Echo resta libero).
API_TOKEN=

# Domande di seguito: se la risposta finisce con "?" l'Echo riascolta senza bisogno di "Alexa".
FOLLOWUP=1
# Nella domanda di seguito manda all'agente anche la domanda e la risposta di prima (solo per quel seguito,
# altrimenti "sì" o "la seconda" non avrebbero senso). 0: solo la domanda, come sempre.
FOLLOWUP_CONTEXT=1

# Ora e fuso orario per l'Echo (come li darebbe Home Assistant). TIMEZONE vuoto: quello del container.
TIMEZONE=Europe/Rome
# Posizione di casa: l'Echo la usa per scegliere il fuso orario giusto. Facoltativa.
HOME_LATITUDE=
HOME_LONGITUDE=

# Tasti, wake word, Drop In e azioni dell'Echo inoltrati come POST JSON (es. un webhook del tuo agente o di n8n).
EVENT_WEBHOOK=
ANNOUNCE_TIMEOUT=120

# Dove il bridge salva le chiavi di cifratura degli Echo.
STATE_DIR=/var/lib/echo-bridge/state

LOG_LEVEL=INFO
